# Knowledge service storage configuration (EXAMPLE — placeholders only).
#
# Copy to .env for local use, or set these as environment variables in your host
# (e.g. Netlify site settings). NEVER commit a real .env or real credentials.
# .env is already gitignored for this service.

# --- Driver selection -------------------------------------------------------
# 'sqlite' (default) for local development and tests.
# 'libsql' for the durable remote Turso database (production).
KNOWLEDGE_DB_DRIVER=sqlite

# --- SQLite (driver=sqlite) -------------------------------------------------
# Optional path to the local sqlite file. ':memory:' for an ephemeral DB.
# KNOWLEDGE_DB_FILE=./data/knowledge.db

# --- libSQL / Turso (driver=libsql) -----------------------------------------
# Remote database URL. For a real Turso database this looks like:
#   libsql://<database-name>-<org-slug>.turso.io
# For secret-free local testing you may use ':memory:' or 'file:./data/kg.db'.
# KNOWLEDGE_DB_URL=libsql://REPLACE-with-your-database.turso.io

# Auth token for the remote database. REQUIRED for a remote libsql:// URL.
# Server-side only — never expose to browser code, logs, or committed files.
# KNOWLEDGE_DB_AUTH_TOKEN=REPLACE-with-your-turso-auth-token

# --- Internal API authentication --------------------------------------------
# Shared secret required by the internal knowledge Netlify function.
# KNOWLEDGE_API_INTERNAL_SECRET=REPLACE-with-a-strong-random-secret
