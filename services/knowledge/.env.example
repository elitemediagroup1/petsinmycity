# Knowledge service storage configuration (EXAMPLE — placeholders only).
#
# Copy to .env for local use, or set these as environment variables in your host
# (e.g. Netlify site settings). NEVER commit a real .env or real credentials.
# .env is already gitignored for this service.

# --- Driver selection -------------------------------------------------------
# 'sqlite' (default) for local development and automated tests.
# 'loop'   for durable production storage through EMG Loop (the system of record;
#          Loop persists through Neon). PetsInMyCity never connects to Neon.
KNOWLEDGE_DB_DRIVER=sqlite

# --- SQLite (driver=sqlite) -------------------------------------------------
# Optional path to the local sqlite file. ':memory:' for an ephemeral DB.
# Local/test only. Never used in production.
# KNOWLEDGE_DB_FILE=./data/knowledge.db

# --- EMG Loop (driver=loop) -------------------------------------------------
# Base URL of the EMG Loop platform API (no trailing slash), e.g.
#   https://app.emgloop.com
# EMG_LOOP_API_BASE_URL=https://REPLACE-with-loop-host

# Service-to-service token. Sent as the 'x-emg-loop-secret' header, matching Loop's
# gateway convention. Server-side ONLY — never expose to browser code, logs, or
# committed files. Provision this yourself in Loop and paste it into Netlify.
# EMG_LOOP_SERVICE_TOKEN=REPLACE-with-loop-service-token

# Producer + tenant scope. platform defaults to 'petsinmycity'. Organization /
# workspace / property ids are supplied once Loop confirms its tenancy for this
# property; they scope reads and writes so knowledge never crosses tenants.
# EMG_LOOP_PLATFORM=petsinmycity
# EMG_LOOP_ORGANIZATION_ID=REPLACE-with-loop-org-id
# EMG_LOOP_WORKSPACE_ID=REPLACE-with-loop-workspace-id
# EMG_LOOP_PROPERTY_ID=petsinmycity

# Optional request timeout in milliseconds (default 8000).
# EMG_LOOP_TIMEOUT_MS=8000

# --- Internal API authentication --------------------------------------------
# Shared secret required by the internal knowledge Netlify function.
# KNOWLEDGE_API_INTERNAL_SECRET=REPLACE-with-a-strong-random-secret
